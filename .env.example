# ==============================================================================
#  ROOT SERVER / VERCEL BACKEND ENVIRONMENT VARIABLES (.env)
# ==============================================================================
#  These variables are used by Express serverless functions (/api/*) and backend scripts.
#  In production, add these under Vercel -> Project Settings -> Environment Variables.
# ==============================================================================

# ── 1. Supabase Database & Admin Service Credentials ─────────────────────────
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ── 2. Cloudflare Turnstile Bot Defense ─────────────────────────────────────────
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key_here

# ── 3. Resend Transactional Email & Support Inbound ───────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Nicoman Tourism <support@yourdomain.com>
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret_here
RESEND_INBOUND_ADDRESS=support@yourdomain.resend.app
